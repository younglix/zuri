# Local dev only — Railway injects DATABASE_URL automatically when a Postgres
# service is attached to this app; you do not need to set it there.
DATABASE_URL=postgresql://postgres:Isaac224488@localhost:5432/zuricrypto

# Required in production so sessions/CSRF tokens survive restarts.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
